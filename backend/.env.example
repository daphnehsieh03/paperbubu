DATABASE_URL=postgresql+psycopg://papertrail:papertrail@127.0.0.1:5432/papertrail
# Or without Docker:
# DATABASE_URL=sqlite:///./papertrail.db

REDIS_URL=redis://127.0.0.1:6379/0

UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:3000
JWT_SECRET=change-me-to-a-long-random-string
# Short-lived access JWT (minutes). Refresh cookie TTL = JWT_REFRESH_EXPIRE_DAYS.
# JWT_ACCESS_EXPIRE_MINUTES=30
# JWT_REFRESH_EXPIRE_DAYS=14
# For HTTPS deployments behind a reverse proxy:
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none
